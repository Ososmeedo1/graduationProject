# API Mode: 'static' or 'api'
VITE_API_MODE=api

# App Name (preferred)
VITE_APP_NAME=RAFIQ

# Auth Mode: 'static' or 'api'
VITE_AUTH_MODE=api

# API Base URL (required for 'api' mode)
VITE_API_BASE_URL=https://tourestaapi.runasp.net/api

# Optional dev proxy target
VITE_API_PROXY_TARGET=https://tourestaapi.runasp.net

# Auth API Base URL (optional, defaults to VITE_API_BASE_URL)
VITE_AUTH_API_URL=https://tourestaapi.runasp.net

# App Title
VITE_APP_TITLE=RAFIQ
